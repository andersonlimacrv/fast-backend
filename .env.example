# fast-backend — example env (copy to .env, never commit secrets)
ENVIRONMENT=local
SECRET_KEY=change-me-in-production-min-32-chars
JWT_ISSUER=fast-backend
JWT_AUDIENCE=fast-backend-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Argon2id cost (calibrate to target hardware; OWASP)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastbackend
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=60
# Registration throttle (per-IP failure budget; 201 never consumes) + global
# per-IP anti-abuse ceiling on /auth/* and /admin/* (change rate-limit-global).
REGISTER_MAX_ATTEMPTS=10
REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_GLOBAL_MAX_ATTEMPTS=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# Session cookies for browser SPAs (change auth-cookies-http-only; transition).
# Off by default: flag off = header-only behavior (localStorage+Bearer, current
# e2e). Flag on = dual read (header OR HttpOnly cookie) + Set-Cookie on
# login/refresh/switch + CSRF synchronizer-token on cookie mutations.
# Header-only removal is a dedicated follow-up change; rollback = flag off.
AUTH_COOKIE_ENABLED=false
# Secure needs HTTPS (staging/prod behind Caddy TLS keep true; production
# boots fail with cookies on + Secure off). Local dev over plain http MUST set
# AUTH_COOKIE_SECURE=false or the browser will not send the cookies.
AUTH_COOKIE_SECURE=true
# lax (default; top-level navigation keeps working) | strict (tighter).
AUTH_COOKIE_SAMESITE=lax
# Optional cookie Domain (empty = host-only). CSRF kill-switch (default on;
# production boots fail with cookies on + CSRF off).
# AUTH_COOKIE_DOMAIN=
CSRF_ENABLED=true
TENANCY_MODE=single
# JSON arrays (or comma-separated): TRUSTED_HOSTS / CORS_ORIGINS
TRUSTED_HOSTS=["*"]
# Reverse proxies: TRUSTED_PROXY_HOPS=0 never honors X-Forwarded-For (fail-closed default).
# Behind one proxy (e.g. Caddy TLS, see docs/DEPLOYMENT.md) set TRUSTED_PROXY_HOPS=1.
# TRUSTED_PROXY_HOPS=0
# Dev defaults allow the Vite server (`make dev`, WEB_PORT=5173); tighten both in production
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Email: log | smtp (dev default logs; point at Mailpit for real capture)
EMAIL_BACKEND=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=no-reply@example.com
# Privacy (LGPD): data-controller contact shown in docs/PRIVACY.md (no default on purpose)
# PRIVACY_CONTACT=dpo@example.com
# Storage: local | s3 (MinIO/S3/R2 via endpoint)
STORAGE_BACKEND=local
STORAGE_DIR=./var/storage
STORAGE_MAX_BYTES=10485760
S3_ENDPOINT_URL=
S3_BUCKET=fastbackend
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Jobs
TASK_BROKER_URL=redis://localhost:6379/1
OUTBOX_MAX_ATTEMPTS=5
# Billing (Fase 7, optional; default off — core works without it)
BILLING_ENABLED=false
STRIPE_WEBHOOK_SECRET=
STRIPE_SIGNATURE_TOLERANCE=300
# price_id -> {"key": ..., "limit": ...}
STRIPE_PRICE_MAP={}
# Admin control plane (change A; leaf module, flag-gated like billing)
ADMIN_ENABLED=true
# One-shot root bootstrap key (>=32 chars; required in production; never commit).
# Empty disables root bootstrap entirely (no staff promotion possible).
BOOTSTRAP_KEY=
# Password recovery (change B)
PASSWORD_RESET_TTL_MINUTES=60
FRONTEND_URL=http://localhost:5173
# Social login (change C; contract only, no active provider)
SOCIAL_LOGIN_ENABLED=false